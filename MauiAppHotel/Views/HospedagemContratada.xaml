<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="20" VerticalOptions="CenterAndExpand">

        <Label 
            Text="{Binding QuartoSelecionado.Descricao}"
            TextColor="#D4AF37"
            FontFamily="Kalam"
            FontSize="50"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,10" />

        <Frame Padding="20" BackgroundColor="#1E1E1E" BorderColor="Transparent" CornerRadius="15" Margin="0,10">
            <VerticalStackLayout Spacing="10">

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Adultos: " TextColor="White" FontSize="16" />
                    <Label Text="{Binding QtdAdultos}" TextColor="#F59E0B" FontAttributes="Bold" FontSize="20" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Crianças: " TextColor="White" FontSize="16" />
                    <Label Text="{Binding QtdCriancas}" TextColor="#F59E0B" FontAttributes="Bold" FontSize="20" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <Frame Padding="20" BackgroundColor="#1E1E1E" BorderColor="Transparent" CornerRadius="15" Margin="0,10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="15">

                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" TextColor="White" FontSize="16" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="0" Text="Check-out:" TextColor="White" FontSize="16" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:" TextColor="White" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="0" Grid.Column="1" 
                       Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="#F59E0B"
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"/>

                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="#F59E0B"
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"/>

                <Label Grid.Row="1" Grid.Column="2" 
                       Text="{Binding Estadia}" 
                       TextColor="#F59E0B"
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <Frame Padding="20" BackgroundColor="#1E1E1E" BorderColor="Transparent" CornerRadius="15" Margin="0,10">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Valor Total:" TextColor="White" FontSize="16" VerticalOptions="Center" />
                <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}" 
                       TextColor="#F59E0B"
                       FontAttributes="Bold"
                       FontSize="20"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar"
                BackgroundColor="#D4AF37" 
                TextColor="#121212" 
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="25"
                HeightRequest="50"
                Margin="0,20,0,0"
                HorizontalOptions="Center"
                WidthRequest="200"
                Clicked="Voltar_Clicked" />

    </VerticalStackLayout>
</ContentPage>