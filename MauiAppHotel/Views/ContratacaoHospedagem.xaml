<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#121212">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20">

        <Label 
            Text="Cálculo da Diária"
            FontFamily="Kalam"
            FontSize="50"
            TextColor="#D4AF37" 
            HorizontalTextAlignment="Center"
            Margin="0,0,0,10" />

        <Frame Padding="20" BackgroundColor="#1E1E1E" BorderColor="Transparent" CornerRadius="15">
            <VerticalStackLayout Spacing="15">

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, 2*" RowSpacing="20">

                    <Label Grid.Row="0" Grid.Column="0" 
                           Text="Adultos:" 
                           TextColor="White" 
                           FontSize="16"
                           VerticalOptions="Center" />

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="#F59E0B" 
                           FontAttributes="Bold"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             VerticalOptions="Center" />

                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="Crianças:" 
                           TextColor="White" 
                           FontSize="16"
                           VerticalOptions="Center" />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="#F59E0B" 
                           FontAttributes="Bold"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             VerticalOptions="Center" />

                </Grid>

                <BoxView HeightRequest="1" Color="#2D2D2D" Margin="0,10" />

                <Label Text="Escolha sua Suíte" TextColor="#A0A0A0" FontSize="14" />

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação" 
                        TitleColor="#888888"
                        TextColor="White" 
                        ItemDisplayBinding="{Binding Descricao}"/>

                <Frame Padding="15" Margin="0,10,0,10" BackgroundColor="#121212" BorderColor="Transparent" CornerRadius="10">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Período da Estadia" FontAttributes="Bold" TextColor="White" />

                        <HorizontalStackLayout Spacing="15">
                            <Label Text="Check-in:" VerticalOptions="Center" TextColor="#A0A0A0" />
                            <DatePicker x:Name="dtpck_checkin"
                                        Format="dd/MM/yyyy" 
                                        TextColor="White"
                                        DateSelected="dtpck_checkin_DateSelected"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="15">
                            <Label Text="Check-out:" VerticalOptions="Center" TextColor="#A0A0A0" />
                            <DatePicker x:Name="dtpck_checkout" 
                                        Format="dd/MM/yyyy" 
                                        TextColor="White" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar" 
                        BackgroundColor="#D4AF37" 
                        TextColor="#121212" 
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,10,0,0"
                        Clicked="Avancar_Clicked"/>

            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>